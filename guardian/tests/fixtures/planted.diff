+"""Export comparison results to S3 and Snowflake."""
+
+import logging
+
+import boto3
+
+LOG = logging.getLogger(__name__)
+
+AWS_ACCESS_KEY_ID = "AKIAFAKEFAKEFAKE0000"
+AWS_SECRET_ACCESS_KEY = "fakeFAKEfakeFAKEfakeFAKEfakeFAKE00000000"
+
+
+def upload_to_s3(local, bucket, key):
+    """Upload a local file to S3."""
+    client = boto3.client(
+        "s3",
+        aws_access_key_id=AWS_ACCESS_KEY_ID,
+        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
+    )
+    client.upload_file(local, bucket, key)
+
+
+def export_mismatches(cursor, table, bucket):
+    """Write every mismatched customer row to S3."""
+    cursor.execute(f"SELECT * FROM {table}")
+    for row in cursor.fetchall():
+        LOG.info("Exporting mismatch for customer %s (%s)", row["customer_id"], row["email"])
+        path = f"/tmp/{row['customer_id']}.json"
+        upload_to_s3(path, bucket, f"mismatches/{row['customer_id']}.json")
+
+
+def resize_warehouse(cursor):
+    """Give the export more compute."""
+    cursor.execute("ALTER WAREHOUSE COMPARE_WH SET WAREHOUSE_SIZE = 'X4LARGE'")
