{
  "about": "Labelled tickets against three public repos the engine was NOT written for. Build the context with `make eval-public` (clones the pinned commits below). Tickets are written as a developer would phrase them, without the function name. 'expand' simulates the skill's model step.",
  "repos": {
    "requests": {"url": "https://github.com/psf/requests.git", "sha": "3c7baaa05ab4aa49cc819ce3a819d260de19c157"},
    "axios": {"url": "https://github.com/axios/axios.git", "sha": "9f0f4ddfe72b4c06afafe1a658e6ee53d35b5760"},
    "spring-petclinic": {"url": "https://github.com/spring-projects/spring-petclinic.git", "sha": "500158f732419217507c7656904b8e6aa1bcc0d6"}
  },
  "cases": [
    {"id": "rq-strip-auth", "ticket": "Drop the Authorization header when a redirect sends us to a different host",
     "expect": ["should_strip_auth", "rebuild_auth"], "expand": "drop=strip,remove; different host=origin,netloc; strip_auth"},
    {"id": "rq-cookies", "ticket": "Copy cookies from an HTTP response into our cookie jar",
     "expect": ["extract_cookies_to_jar"], "expand": "copy=extract,store; cookie jar=cookiejar; extract_cookies"},
    {"id": "rq-netrc", "ticket": "Pick up login credentials for a host from the user's .netrc file",
     "expect": ["get_netrc_auth"], "expand": "credentials=auth,login,password; netrc; get_auth"},
    {"id": "rq-charset", "ticket": "Work out the text encoding from the Content-Type response header",
     "expect": ["get_encoding_from_headers"], "expand": "text encoding=charset,encoding; content-type=headers; get_encoding"},
    {"id": "rq-body-length", "ticket": "Find the length of a request body that may be a file, a string or a generator",
     "expect": ["super_len"], "expand": "length=len,size,content-length; body=data,stream; body_length, get_length"},
    {"id": "rq-proxy-bypass", "ticket": "Skip the proxy for hosts listed in the no_proxy environment variable",
     "expect": ["should_bypass_proxies", "get_environ_proxies"], "expand": "skip=bypass,ignore; no_proxy=proxies,environment; bypass_proxy"},
    {"id": "rq-proxy-select", "ticket": "Choose which proxy URL to use for a given request URL and scheme",
     "expect": ["select_proxy"], "expand": "choose=select,pick,resolve; get_proxy, select_proxy"},
    {"id": "rq-link-header", "ticket": "Parse the Link header used for pagination into a list of links",
     "expect": ["parse_header_links", "links"], "expand": "link header=links,rel next; parse_links"},
    {"id": "rq-add-scheme", "ticket": "Add http:// to a URL when the user leaves the scheme off",
     "expect": ["prepend_scheme_if_needed"], "expand": "add=prepend,default; scheme=protocol; ensure_scheme"},
    {"id": "rq-header-check", "ticket": "Reject header values that contain newlines or leading whitespace",
     "expect": ["check_header_validity", "_validate_header_part"], "expand": "reject=validate,invalid; newlines=injection,crlf; validate_header"},
    {"id": "rq-ci-dict", "ticket": "A dictionary for HTTP headers where key lookups ignore case",
     "expect": ["CaseInsensitiveDict"], "expand": "ignore case=case-insensitive,lower; CaseInsensitiveDict, case_insensitive"},
    {"id": "ax-join-url", "ticket": "Join a base URL and a relative path without doubling the slash",
     "expect": ["combineURLs"], "expand": "join=combine,concat,merge; urljoin, combineUrls"},
    {"id": "ax-absolute", "ticket": "Tell whether a URL string is absolute or relative",
     "expect": ["isAbsoluteURL"], "expand": "absolute=protocol,scheme; isAbsolute, isAbsoluteUrl"},
    {"id": "ax-query", "ticket": "Serialise a params object into the query string of a URL",
     "expect": ["buildURL"], "expand": "serialise=serialize,encode,stringify; query string=params,search; buildUrl, encodeParams"},
    {"id": "ax-formdata", "ticket": "Convert a plain JavaScript object into multipart FormData",
     "expect": ["toFormData"], "expand": "convert=serialize,transform; multipart=form-data,formdata; objectToFormData"},
    {"id": "ax-throttle", "ticket": "Limit how often the upload progress callback fires",
     "expect": ["throttle", "progressEventReducer"], "expand": "limit=throttle,debounce,rate; progress=onUploadProgress; throttle"},
    {"id": "ax-speed", "ticket": "Estimate transfer speed in bytes per second while downloading",
     "expect": ["speedometer"], "expand": "speed=rate,throughput,bytes per second; speedometer, bandwidth"},
    {"id": "ax-status", "ticket": "Resolve or reject the promise depending on the HTTP status code",
     "expect": ["settle", "validateStatus"], "expand": "resolve or reject=settle,promise; status code=validateStatus"},
    {"id": "ax-merge-config", "ticket": "Merge per-request options over the instance defaults",
     "expect": ["mergeConfig"], "expand": "options=config,defaults; merge=combine,deep merge; mergeConfig, mergeOptions"},
    {"id": "ax-abort-signals", "ticket": "Combine several AbortSignals and a timeout into one signal",
     "expect": ["composeSignals"], "expand": "abort=cancel,abortcontroller; combine=compose,merge; composeSignals, anySignal"},
    {"id": "pc-owner-search", "ticket": "Search owners by the start of their surname, one page at a time",
     "expect": ["findByLastNameStartingWith", "findPaginatedForOwnersLastName"], "expand": "surname=last name,lastname; page=pageable,pagination; findByLastName"},
    {"id": "pc-pet-validate", "ticket": "Validate a pet form: name required, type required, birth date required",
     "expect": ["PetValidator"], "expand": "validate=validator,errors,rejectValue; PetValidator, validatePet"},
    {"id": "pc-pettype-parse", "ticket": "Turn the pet type text from the form into a PetType object and back",
     "expect": ["PetTypeFormatter"], "expand": "turn=convert,parse,print,formatter; PetTypeFormatter, PetTypeConverter"},
    {"id": "pc-vets", "ticket": "Show the list of vets with their specialties, paginated",
     "expect": ["showVetList", "VetController"], "expand": "vets=vet,veterinarian; list=findAll,page; showVets"},
    {"id": "neg-sso", "ticket": "Add single sign-on with SAML for staff logins", "negative": true,
     "expand": "sso=saml,oidc,identity provider; samlLogin"},
    {"id": "neg-ledger", "ticket": "Post double-entry ledger journal lines for each card settlement", "negative": true,
     "expand": "ledger=journal,debit,credit,bookkeeping; postJournal"},
    {"id": "neg-kafka", "ticket": "Publish an event to Kafka when a payment is approved", "negative": true,
     "expand": "kafka=producer,topic,event bus; publishEvent"},
    {"id": "neg-pdf", "ticket": "Generate a PDF invoice for each appointment", "negative": true,
     "expand": "pdf=document,itext,render; generatePdf"}
  ]
}
