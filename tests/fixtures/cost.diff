@@ -12,2 +12,11 @@ BUCKET = "orders-archive"
 def load_orders(cur):
+    cur.execute("SELECT * FROM orders")
+    rows = cur.fetchall()
+    s3 = boto3.client("s3")
+    for row in rows:
+        s3.put_object(Bucket=BUCKET, Key=row[0], Body=row[1])
+    return len(rows)
+
+def recent_orders(cur):
+    cur.execute("SELECT id, total FROM orders WHERE created_at > %s LIMIT 100", (CUTOFF,))
+    return cur.fetchall()
